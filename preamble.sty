% Custom reference command
% Save the original \nameref command
\LetLtxMacro{\originalnameref}{\nameref}

% Redefine \nameref to handle missing labels
\makeatletter
\renewcommand{\nameref}[1]{%
  \@ifundefined{r@#1}{%
    \textcolor{red}{\texttt{#1}}% Missing label → show name in red
  }{%
    \originalnameref{#1}% Existing label → original behavior
  }%
}
\makeatother

% Command to set custom plural forms for specific labels
\newcommand{\SetPluralName}[2]{%
  \csgdef{plur@#1}{#2}%
}

% Main plural reference command
\newcommand{\namerefs}[1]{%
    \ifcsname plur@#1\endcsname%
        \hyperref[{#1}]{\csname plur@#1\endcsname}% Use custom plural if defined
    \else%
        \hyperref[{#1}]{\originalnameref*{#1}s}% Just add 's' as fallback
    \fi%
}

% Theorem environments
\numberwithin{equation}{section}
\declaretheorem[style=plain, numberwithin=section]{theorem, lemma, proposition, corollary}
\declaretheorem[style=definition, numberwithin=section,qed=\(\lrcorner\)]{definition}
\declaretheorem[style=definition, numberwithin=section, qed=\(\lozenge\)]{example}
\declaretheorem[style=remark, numberwithin=section, qed=\(\triangledown\)]{remark}
\declaretheorem[style=remark, numbered=no]{notation}

