  url = {http://arxiv.org/abs/1302.5834},
  abstract = {Let X be a smooth complex algebraic variety with the Zariski topology, and let Y be the underlying complex manifold with the complex topology. Grothendieck's algebraic de Rham theorem asserts that the singular cohomology of Y with complex coefficients can be computed from the complex of sheaves of algebraic differential forms on X. This article gives an elementary proof of Grothendieck's algebraic de Rham theorem, elementary in the sense that we use only tools from standard textbooks as well as Serre's FAC and GAGA papers.},
