\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{packages}

%% --- Colors (MUST BE LOADED FIRST) ---
\RequirePackage[dvipsnames]{xcolor}

%% --- Encoding & Fonts ---
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{microtype}

% Modern Palatino (Text and Math)
\RequirePackage{newpxtext}
\RequirePackage{newpxmath}
\RequirePackage[scaled=0.95]{cabin}       % Humanist Sans Serif
\RequirePackage[scaled=1.05]{inconsolata} % Monospace

%% --- Utilities ---
\RequirePackage{xstring}
\RequirePackage{etoolbox}
\RequirePackage{xargs}
\RequirePackage{letltxmacro}
\RequirePackage[normalem]{ulem}
\RequirePackage{cancel}
\RequirePackage{afterpage}
\RequirePackage{parskip}
\RequirePackage{float} % Fixes [H] in figures
\RequirePackage{lipsum}

%% --- Page Layout ---
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{epigraph}
\RequirePackage[explicit]{titlesec}
\RequirePackage{titletoc}

%% --- Math & Diagrams ---
\RequirePackage{amsmath}
\RequirePackage{amsfonts}

% Fix: 'newpxmath' defines \Bbbk, so we must undefine it before amssymb
\let\Bbbk\relax 
\RequirePackage{amssymb}

% Fix: 'newpxmath' or others may define \openbox, undefine before amsthm
\let\openbox\relax
\RequirePackage{amsthm}

\RequirePackage{bbm}
\RequirePackage{mathtools}
\RequirePackage{thmtools, thm-restate}
\RequirePackage{tikz, tikz-cd, tikz-3dplot}
\tdplotsetmaincoords{70}{110}
\usetikzlibrary{decorations.markings}
\RequirePackage{mathrsfs}

% Stylish Boxes
\RequirePackage[most]{tcolorbox}

%% --- Images & Subfiles ---
\RequirePackage{subfiles}
\RequirePackage{graphicx}
\graphicspath{{./images}}

%% --- Lists & Notes ---
\RequirePackage{enumitem}
% Fix: todonotes requires a specific margin width to avoid warnings
\setlength{\marginparwidth}{2cm} 
\RequirePackage[textsize=small]{todonotes}

%% --- Links (Load Last) ---
\RequirePackage{hyperref}
\RequirePackage{nameref}
\RequirePackage[user, xr]{zref}

%% --- Bibliography ---
\RequirePackage[backend=biber, style=alphabetic, sorting=nty, backref=true]{biblatex}
