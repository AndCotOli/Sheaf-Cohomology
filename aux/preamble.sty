\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}

%% Packages
\RequirePackage{aux/packages}

%% Configuration
% afterpage
\newcommand\blankpage{%
    \null
    \thispagestyle{empty}%
    \addtocounter{page}{-1}%
    \newpage}

% fancyhdr
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[RE]{\leftmark} % Chapter name
\fancyhead[LO]{\rightmark} % Section name

% todonotes
\newcommandx{\unsure}[2][1=]{\todo[linecolor=red,backgroundcolor=red!25,bordercolor=red,#1]{#2}}
\newcommandx{\change}[2][1=]{\todo[linecolor=blue,backgroundcolor=blue!25,bordercolor=blue,#1]{#2}}
\newcommandx{\info}[2][1=]{\todo[linecolor=OliveGreen,backgroundcolor=OliveGreen!25,bordercolor=OliveGreen,#1]{#2}}
\newcommandx{\improvement}[2][1=]{\todo[linecolor=Plum,backgroundcolor=Plum!25,bordercolor=Plum,#1]{#2}}

% hyperref
\hypersetup{
  hypertexnames=false,
  colorlinks=true,
  linkcolor=blue,
  citecolor=red,
  urlcolor=blue,
}

\zxrsetup{
  tozreflabel=false,
  toltxlabel=true,
}

% Custom reference command
% Save the original \nameref command
\LetLtxMacro{\originalnameref}{\nameref}

% Redefine \nameref to handle missing labels
\makeatletter
\renewcommand{\nameref}[1]{%
  \@ifundefined{r@#1}{%
    \textcolor{red}{\texttt{#1}}% Missing label → show name in red
  }{%
    \originalnameref{#1}% Existing label → original behavior
  }%
}
\makeatother

% Command to set custom plural forms for specific labels
\newcommand{\SetPluralName}[2]{%
  \csgdef{plur@#1}{#2}%
}

% Main plural reference command
\newcommand{\namerefs}[1]{%
    \ifcsname plur@#1\endcsname%
        \hyperref[{#1}]{\csname plur@#1\endcsname}% Use custom plural if defined
    \else%
        \hyperref[{#1}]{\originalnameref*{#1}s}% Just add 's' as fallback
    \fi%
}

% Theorem environments
\numberwithin{equation}{section}
\declaretheorem[style=plain, numberwithin=section]{theorem, lemma, proposition, corollary}
\declaretheorem[style=definition, numberwithin=section,qed=\(\lrcorner\)]{definition}
\declaretheorem[style=definition, numberwithin=section, qed=\(\lozenge\)]{example}
\declaretheorem[style=remark, numberwithin=section, qed=\(\triangledown\)]{remark}
\declaretheorem[style=remark, numbered=no]{notation}

% Bibliography
\addbibresource{Bibliography.bib}

\RequirePackage{aux/notation}

\newcommand{\curs}{Curs 2025/2026}
