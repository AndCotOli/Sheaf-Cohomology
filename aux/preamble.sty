\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}

\RequirePackage{aux/packages}

%% --- Color Palette ---
\definecolor{accentcolor}{RGB}{30, 60, 110} % Navy Blue
\definecolor{thmcolor}{RGB}{160, 40, 40}    % Muted Red
\definecolor{defcolor}{RGB}{30, 90, 70}     % Muted Teal
\definecolor{notecolor}{RGB}{100, 100, 100} % Gray

%% --- Page Layout ---
% Adjusted for better readability (Golden Ratio-ish)
\geometry{
    a4paper,
    top=3cm,
    bottom=3cm,
    left=3.5cm,
    right=3.5cm,
    heightrounded,
}

%% --- Header & Footer ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\small\sffamily\color{gray}\thepage}
\fancyhead[RO]{\small\sffamily\color{gray}\thepage}
\fancyhead[RE]{\small\sffamily\color{gray}\nouppercase{\leftmark}}
\fancyhead[LO]{\small\sffamily\color{gray}\nouppercase{\rightmark}}

\newcommand\blankpage{%
    \null
    \thispagestyle{empty}%
    \addtocounter{page}{-1}%
    \newpage}

  %% --- Epigraph Styling ---
\setlength{\epigraphwidth}{0.55\textwidth} % Width of the quote block (approx half page)
\renewcommand{\epigraphflush}{flushright}  % Pushes the block to the right
\renewcommand{\sourceflush}{flushright}    % Aligns the author name to the right
\renewcommand{\textflush}{flushright}      % Aligns the quote text to the right

% Font settings: Small, Italic, and Sans-Serif for contrast
\renewcommand{\epigraphsize}{\small\itshape\sffamily}

% Optional: Make the dividing line your accent color
% \renewcommand{\epigraphrule}{0pt} % Set to 1pt if you WANT a line, 0pt for clean look
% If you want a colored line, use this instead of the line above:
\setlength{\epigraphrule}{1pt}
\renewcommand{\@epirule}{\color{accentcolor}\rule[.5ex]{\epigraphwidth}{\epigraphrule}}

%% --- List Styling ---
% 1. Remove extra vertical space
% 2. Change bullets to match your color scheme
\setlist[itemize]{
    noitemsep, 
    topsep=5pt, 
    label=\textcolor{accentcolor}{\bfseries\textendash} % A bold, colored dash
}
\setlist[enumerate]{
    noitemsep, 
    topsep=5pt, 
    font=\bfseries\sffamily\color{accentcolor} % Bold colored numbers
}
  
%% --- Typography: Section Headers ---
% Sans-serif, bold, colored
\titleformat{\part}[display]
  {\thispagestyle{empty}\raggedleft} % Right align, remove headers/footers
  {\bfseries\sffamily\color{accentcolor}\fontsize{20}{20}\selectfont\MakeUppercase{\partname}\ \thepart} % "PART I"
  {1em} % Vertical space between "PART I" and the Title
  {\titlerule[2pt]\vspace{1ex}\bfseries\sffamily\color{accentcolor}\fontsize{40}{48}\selectfont#1} % The Title (e.g., "Category Theory")
 
\titleformat{\chapter}[display]
  {\bfseries\sffamily\huge\color{accentcolor}}
  {\Large\chaptertitlename\ \thechapter}
  {1ex}
  {\titlerule[1pt]\vspace{1ex}#1}

\titleformat{\section}
  {\bfseries\sffamily\Large\color{accentcolor}}
  {\thesection}
  {1em}
  {#1}

\titleformat{\subsection}
  {\bfseries\sffamily\large\color{accentcolor}}
  {\thesubsection}
  {1em}
  {#1}

  
%% --- Utilities: Todo Notes ---
\newcommandx{\unsure}[2][1=]{\todo[linecolor=red,backgroundcolor=red!25,bordercolor=red,#1]{#2}}
\newcommandx{\change}[2][1=]{\todo[linecolor=blue,backgroundcolor=blue!25,bordercolor=blue,#1]{#2}}
\newcommandx{\info}[2][1=]{\todo[linecolor=OliveGreen,backgroundcolor=OliveGreen!25,bordercolor=OliveGreen,#1]{#2}}
\newcommandx{\improvement}[2][1=]{\todo[linecolor=Plum,backgroundcolor=Plum!25,bordercolor=Plum,#1]{#2}}

%% --- Hyperref ---
\hypersetup{
    hidelinks,
    linktoc=all,
    colorlinks=true,
    linkcolor=accentcolor,
    citecolor=accentcolor,
    urlcolor=accentcolor,
    hypertexnames=false,
    plainpages=false,
}


\zxrsetup{tozreflabel=false, toltxlabel=true}

%% --- Reference Logic ---
\LetLtxMacro{\originalnameref}{\nameref}
\makeatletter
\renewcommand{\nameref}[1]{%
  \@ifundefined{r@#1}{\textcolor{red}{\texttt{#1}}}{\originalnameref{#1}}%
}
\makeatother
\newcommand{\SetPluralName}[2]{\csgdef{plur@#1}{#2}}
\newcommand{\namerefs}[1]{%
    \ifcsname plur@#1\endcsname%
        \hyperref[{#1}]{\csname plur@#1\endcsname}%
    \else%
        \hyperref[{#1}]{\originalnameref*{#1}s}%
    \fi%
}

%% --- THEOREM SETUP ---

% 1. Define the internal styles using thmtools
% This sets the font of the head (e.g., "Theorem 1.1") and the body.
\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{thmcolor},
    bodyfont=\normalfont,
    spaceabove=1em,
    spacebelow=1em,
]{thmstylered}

\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{defcolor},
    bodyfont=\normalfont,
    spaceabove=1em,
    spacebelow=1em,
]{thmstylegreen}

\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{notecolor},
    bodyfont=\normalfont,
    spaceabove=1em,
    spacebelow=1em,
]{thmstylegray}

% 2. Declare the environments (Standard Syntax)
\numberwithin{equation}{section}


\declaretheorem[style=thmstylered, numberwithin=section]{theorem}
\declaretheorem[style=thmstylered, numberwithin=section, sibling=theorem]{lemma, proposition, corollary}
\declaretheorem[style=thmstylegreen, numberwithin=section, sibling=theorem]{definition}
\declaretheorem[style=thmstylegray, numberwithin=section, sibling=theorem]{example, remark}
\declaretheorem[style=thmstylegray, numbered=no]{construction, notation}

% 3. Apply the TColorBox "Skin" to the environments
% This adds the vertical bar on the left without changing syntax.

% Red Bar for Theorems
\tcolorboxenvironment{theorem}{
    blanker, breakable, left=1em,
    borderline west={2pt}{0pt}{thmcolor},
    before skip=10pt, after skip=10pt
}
\tcolorboxenvironment{lemma}{
    blanker, breakable, left=1em,
    borderline west={2pt}{0pt}{thmcolor},
    before skip=10pt, after skip=10pt
}
\tcolorboxenvironment{proposition}{
    blanker, breakable, left=1em,
    borderline west={2pt}{0pt}{thmcolor},
    before skip=10pt, after skip=10pt
}
\tcolorboxenvironment{corollary}{
    blanker, breakable, left=1em,
    borderline west={2pt}{0pt}{thmcolor},
    before skip=10pt, after skip=10pt
}

% Teal Bar for Definitions
\tcolorboxenvironment{definition}{
    blanker, breakable, left=1em,
    borderline west={2pt}{0pt}{defcolor},
    before skip=10pt, after skip=10pt
}

% Gray Bar for Examples/Remarks
\tcolorboxenvironment{example}{
    blanker, breakable, left=1em,
    borderline west={2pt}{0pt}{notecolor},
    before skip=10pt, after skip=10pt
}
\tcolorboxenvironment{remark}{
    blanker, breakable, left=1em,
    borderline west={2pt}{0pt}{notecolor},
    before skip=10pt, after skip=10pt
}


%% --- TikzCD ---
\tikzcdset{
    arrow style=tikz,
    diagrams={>=stealth} % 'stealth' is modern; 'latex' is classic
}

%% --- Bibliography ---
\addbibresource{Bibliography.bib}

%% --- Bibliography Backrefs ---
\DefineBibliographyStrings{english}{%
  backrefpage = {cited on p\adddot},
  backrefpages = {cited on pp\adddot},
}

%% --- Conditionally Clear Fields ---
\AtEveryBibitem{%
  \ifentrytype{online}
    {} % Do nothing if it's an online source (keep the URL)
    {\clearfield{url}%      % Otherwise, clear URL
     \clearfield{urldate}%  % Clear "visited on" date
     \clearfield{doi}%      % Clear DOI
     \clearfield{isbn}}%    % Clear ISBN
}

\RequirePackage{aux/notation}

\newcommand{\curs}{Curs 2025/2026}
% Font fixes for cover page if needed
\newcommand{\cmrbold}[1]{{\usefont{T1}{cmr}{bx}{n} #1}}
\newcommand{\cmrboldsc}[1]{{\usefont{T1}{cmr}{bx}{sc} #1}}
