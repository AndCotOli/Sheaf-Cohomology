\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notation}

% Math operators
\newcommand*\quot[2]{{^{\textstyle #1}\big/_{\textstyle #2}}} % Quotient
\DeclareMathOperator*{\colim}{colim}
\DeclareMathOperator*{\pre}{pre}
\DeclareMathOperator*{\op}{op}
\newcommand\res{\operatorname{res}}

% Arrows
\newcommand\monoarrow{\rightarrowtail}
\newcommand\epiarrow{\twoheadrightarrow}
\newcommand\isoarrow{\xrightarrow{\sim}}


% Categories
\newcommand{\category}[1]{\mathsf{#1}}
\newcommand\Hom{\operatorname{Hom}}
\newcommand\Mor{\operatorname{Mor}}
\newcommand{\opcategory}[1]{\category{#1}^{\op}}
\newcommand\id{\mathbbm{1}}
\newcommand\Fun[2]{\mathsf{Fun}(#1, #2)}

%% Special categories
\newcommand\Set{\category{Set}}
\newcommand\Grp{\category{Grp}}
\newcommand\Ab{\category{Ab}}
\newcommand\Ring{\category{Ring}}
\newcommand\Top{\category{Top}}
%\newcommand{\Mod}[1]{#1\text{-}\category{Mod}}
\newcommand\Open{\category{Op}} % Open subsets

% Homological Algebra
\DeclareMathOperator*{\im}{im}
\DeclareMathOperator*{\coim}{coim}
\DeclareMathOperator*{\coker}{coker}
\newcommand{\Complex}[2][]{\category{Ch}^{#1}(#2)}
\newcommand{\cohomology}[1]{\operatorname{H}^{#1}}
\newcommand{\mCone}[2]{\operatorname{Cone}(#1)^{#2}}

% Sheaves
\newcommand\PSh{\category{PSh}} % Presheaves
\newcommand\Sh{\category{Sh}} % Sheaves
\newcommand\HomS{\mathcal{H}om} % Hom Sheaf
\newcommand{\sheaf}[1]{\mathscr{#1}}
\newcommand\PMod{\category{PMod}}
\newcommand\Mod{\category{Mod}}
\newcommand\OxMod{\Mod{\sheaf{O}_{X}}}
\newcommand\etale{\operatorname{Et}}
